  {
    "name": "output name on multi-file action",
    "expectedCode": "INVALID_VALUE",
    "plan": {
      "version": 1,
      "actions": [
        {
          "tool": "split",
          "inputs": [1],
          "options": { "mode": "everyN", "everyN": 2 },
          "outputName": "pieces.pdf"
        }
      ]
    }
  },
  {
    "name": "duplicate output names",
    "expectedCode": "DUPLICATE_OUTPUT_NAME",
    "plan": {
      "version": 1,
      "actions": [
        {
          "tool": "merge",
          "inputs": [1, 2],
          "outputName": "same.pdf"
        },
        {
          "tool": "merge",
          "inputs": [1, 2],
          "outputName": "SAME.PDF"
        }
      ]
    }
  },
  {
    "name": "unknown version",
